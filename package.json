{
	"name": "my-app",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@fontsource-variable/public-sans": "^5.2.7",
		"@fontsource-variable/roboto-mono": "^5.2.8",
		"@playwright/test": "^1.58.2",
		"@sentry/svelte": "^10.45.0",
		"@svelte-put/resize": "^4.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/svelte-query": "^6.1.3",
		"@tanstack/svelte-query-devtools": "^6.0.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@threlte/core": "^8.5.0",
		"@threlte/extras": "^9.9.0",
		"@threlte/test": "^1.0.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22",
		"@types/three": "^0.183.1",
		"@viamrobotics/motion-tools": "^1.15.5",
		"@viamrobotics/prime-core": "^0.1.16",
		"@viamrobotics/prime-editor": "^0.0.2",
		"@viamrobotics/sdk": "^0.67.0",
		"@viamrobotics/svelte-sdk": "^1.1.3",
		"@viamrobotics/three": "^0.0.9",
		"@vitest/browser": "^4.1.0",
		"@vitest/browser-playwright": "^4.1.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"lodash-es": "^4.17.23",
		"maplibre-gl": "^5.21.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.17",
		"runed": "^0.37.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"svelte-splitpanes": "^8.0.12",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.1.18",
		"three": "^0.183.2",
		"threlte-uikit": "^1.2.1",
		"type-fest": "^5.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-glsl": "^1.5.6",
		"vitest": "^4.1.0",
		"vitest-browser-svelte": "^2.0.2"
	},
	"keywords": [
		"svelte"
	]
}
