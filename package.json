{
	"name": "@viamrobotics/test-widgets",
	"version": "0.11.2",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wireit",
		"vite-build": "wireit",
		"package": "wireit",
		"svelte-sync": "wireit",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "wireit",
		"check": "wireit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "wireit",
		"lint:fix": "eslint . --fix --concurrency auto",
		"format": "wireit",
		"format:fix": "prettier --write .",
		"test:unit": "vitest",
		"test": "wireit",
		"test:coverage": "wireit",
		"test:e2e": "playwright test",
		"release": "changeset publish"
	},
	"wireit": {
		"build": {
			"dependencies": [
				"vite-build",
				"package"
			]
		},
		"package": {
			"command": "svelte-package && publint",
			"files": [
				"src/lib/**",
				"svelte.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				"dist/**"
			],
			"dependencies": [
				"svelte-sync"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"vite-build": {
			"command": "vite build",
			"files": [
				"src/**",
				"static/**",
				".env",
				".env.*",
				"vite.config.ts",
				"svelte.config.js",
				"postcss.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				"build/**",
				".svelte-kit/output/**"
			],
			"dependencies": [
				"svelte-sync",
				"package"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"svelte-sync": {
			"command": "svelte-kit sync",
			"files": [
				"svelte.config.js",
				"src/**",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				".svelte-kit/generated/**",
				".svelte-kit/types/**",
				".svelte-kit/ambient.d.ts",
				".svelte-kit/non-ambient.d.ts",
				".svelte-kit/tsconfig.json"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"prepack": {
			"dependencies": [
				"package"
			]
		},
		"check": {
			"command": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
			"files": [
				"src/**",
				"tsconfig.json",
				"svelte.config.js",
				"package.json"
			],
			"output": [],
			"dependencies": [
				"svelte-sync"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"lint": {
			"command": "eslint . --concurrency auto",
			"files": [
				"**",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!coverage/**",
				"!test-results/**",
				"!.env*",
				"!**/*.tgz",
				"!.claude/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"format": {
			"command": "prettier --check .",
			"files": [
				"**",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!coverage/**",
				"!test-results/**",
				"!.env*",
				"!**/*.tgz",
				"!.claude/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"test": {
			"command": "vitest --run",
			"files": [
				"src/**",
				"vite.config.ts",
				"svelte.config.js",
				"postcss.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		},
		"test:coverage": {
			"command": "vitest run --coverage",
			"files": [
				"src/**",
				"vite.config.ts",
				"svelte.config.js",
				"postcss.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				"coverage/**"
			],
			"packageLocks": [
				"pnpm-lock.yaml"
			]
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./registry": {
			"types": "./dist/registry.d.ts",
			"svelte": "./dist/registry.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viamrobotics/test-widgets.git"
	},
	"peerDependencies": {
		"@sentry/svelte": ">=8",
		"@threlte/core": ">=8",
		"@threlte/extras": ">=9",
		"@viamrobotics/prime-core": ">=0.1",
		"@viamrobotics/sdk": ">=0.68",
		"@viamrobotics/svelte-sdk": ">=1.1",
		"lodash-es": ">=4",
		"maplibre-gl": ">=5",
		"runed": ">=0.28",
		"svelte": ">=5",
		"three": ">=0.178",
		"threlte-uikit": ">=2"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ag-grid-community/client-side-row-model": "^32.3.9",
		"@ag-grid-community/core": "^32.3.9",
		"@ag-grid-community/styles": "^32.3.9",
		"@changesets/cli": "^2.31.0",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/public-sans": "^5.2.7",
		"@fontsource-variable/roboto-mono": "^5.2.8",
		"@fontsource-variable/space-grotesk": "^5.2.10",
		"@houserules/cli": "^0.4.1",
		"@houserules/plugin-accessibility": "^0.1.3",
		"@houserules/plugin-changesets": "^0.2.2",
		"@houserules/plugin-design": "^0.2.2",
		"@houserules/plugin-prose": "^0.1.4",
		"@houserules/plugin-svelte": "^0.1.2",
		"@houserules/plugin-testing": "^0.2.1",
		"@houserules/plugin-three": "^0.2.1",
		"@houserules/plugin-typescript": "^0.1.2",
		"@playwright/test": "^1.59.1",
		"@sentry/svelte": "^10.50.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/oxide": "^4.2.4",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/svelte-query": "^6.1.25",
		"@tanstack/svelte-query-devtools": "^6.1.25",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@threlte/core": "^8.5.9",
		"@threlte/extras": "^9.15.0",
		"@threlte/test": "^2.1.0",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^25.6.0",
		"@types/three": "^0.183.1",
		"@viamrobotics/prime-core": "^0.1.22",
		"@viamrobotics/sdk": "^0.69.0",
		"@viamrobotics/svelte-sdk": "^1.2.1",
		"@viamrobotics/tailwind-config": "^1.2.0",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.5",
		"@vitest/coverage-v8": "^4.1.5",
		"@zag-js/dialog": "^1.37.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.9.0",
		"eslint-plugin-svelte": "^3.17.1",
		"eslint-plugin-unicorn": "^64.0.0",
		"globals": "^17.5.0",
		"lodash-es": "^4.18.1",
		"maplibre-gl": "^5.24.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"publint": "^0.3.18",
		"runed": "^0.37.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.4.6",
		"svelte-splitpanes": "^8.0.12",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"three": "^0.183.2",
		"threlte-uikit": "^2.0.0",
		"type-fest": "^5.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.0.16",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-glsl": "^1.6.0",
		"vitest": "^4.1.5",
		"vitest-browser-svelte": "^2.1.1",
		"wireit": "^0.14.13"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"pnpm": {
		"overrides": {
			"uuid": ">=14.0.0"
		}
	},
	"dependencies": {
		"svelte-tweakpane-ui": "^1.5.17"
	}
}
