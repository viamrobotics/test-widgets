{
  "$schema": "../node_modules/@houserules/cli/schema/houserules.config.schema.json",
  "version": 2,
  "packageManager": "pnpm",
  "plugins": [
    {
      "name": "@houserules/plugin-prose",
      "alias": "prose"
    },
    {
      "name": "@houserules/plugin-typescript",
      "alias": "ts"
    },
    {
      "name": "@houserules/plugin-svelte",
      "alias": "svelte"
    },
    {
      "name": "@houserules/plugin-three",
      "alias": "three"
    },
    {
      "name": "@houserules/plugin-testing",
      "alias": "testing"
    },
    {
      "name": "@houserules/plugin-changesets",
      "alias": "changesets"
    },
    {
      "name": "@houserules/plugin-design",
      "alias": "design"
    },
    {
      "name": "@houserules/plugin-accessibility",
      "alias": "accessibility"
    }
  ],
  "fix": {
    "runner": "pnpm",
    "filterFlag": "",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "lint:fix",
      "format:fix"
    ],
    "onSubagentStop": false
  },
  "verify": {
    "runner": "pnpm",
    "filterFlag": "",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "verify"
    ]
  },
  "lintableExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "mjs",
    "cjs",
    "svelte",
    "md",
    "json",
    "css",
    "html"
  ],
  "generatedFilePattern": "/(?:CHANGELOG|BACKLOG)\\.md$",
  "guard": {
    "gitCommit": true,
    "gitPush": true,
    "gitStash": true,
    "prCreate": true,
    "custom": []
  },
  "changesets": {
    "enabled": true,
    "stopCheck": true,
    "baseBranch": "main"
  },
  "ledger": {
    "enabled": false
  },
  "design": {
    "themeEntry": "src/app.css"
  },
  "targets": [
    {
      "name": "test-widgets",
      "prefix": "TEST_WIDGETS",
      "packageName": "@viamrobotics/test-widgets",
      "pathPrefix": "",
      "sourcePath": "src",
      "label": "Test Widgets",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    }
  ],
  "moduleOptions": {
    "orchestrate": [
      "research"
    ],
    "svelte/svelte": [],
    "three/three": [
      "threlte"
    ],
    "testing/testing": [
      "typescript",
      "svelte",
      "3d"
    ],
    "accessibility/accessibility": [
      "html",
      "svelte"
    ]
  },
  "modules": [
    "core",
    "lint-fix",
    "session-context",
    "rename",
    "reviewers",
    "debug-session",
    "plans",
    "orchestrate",
    "verify-changed",
    "ready",
    "sweep",
    "read-guard",
    "statusline",
    "code-cleanliness",
    "ci-settings",
    "prose/code-comments",
    "prose/prose-voice",
    "prose/output-prose",
    "prose/pr-description",
    "ts/typescript",
    "svelte/svelte",
    "svelte/svelte-mcp",
    "three/three",
    "testing/testing",
    "testing/playwright-mcp",
    "changesets/changesets",
    "design/design",
    "design/design-review",
    "design/design-tailwind",
    "accessibility/accessibility",
    "accessibility/accessibility-review"
  ],
  "rules": {
    "accessibility-html": {
      "paths": [
        "**/*.html"
      ]
    },
    "accessibility": {
      "paths": [
        "**/*.html",
        "**/*.svelte"
      ]
    },
    "design": {
      "paths": [
        "**/*.css",
        "**/*.svelte"
      ]
    },
    "testing-3d": {
      "paths": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
      ]
    },
    "testing-svelte": {
      "paths": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "vite.config.ts"
      ]
    },
    "testing-typescript": {
      "paths": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
      ]
    },
    "testing": {
      "paths": [
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
      ]
    },
    "three-threlte": {
      "paths": [
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
        "src/lib/components/NavigationMap/plugins/**",
        "src/lib/components/Slam/map2d/hooks/**"
      ]
    }
  }
}
